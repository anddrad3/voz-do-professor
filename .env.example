PORT=3001
HOST=127.0.0.1
BASE_PATH=
DATABASE_PATH=data/public-v2.sqlite
NODE_ENV=production
DEMO_MODE=false
ADMIN_ENABLED=true
ADMIN_PORT=3002
ADMIN_ORIGIN=http://127.0.0.1:3002
# Admin accessed through local SSH tunnel. Set true only if using HTTPS for this origin.
ADMIN_HTTPS=false
REPORT_EMAIL=relatos@exemplo.invalid
AUTO_SYNC=true
# Requires Python3; bounded daily CNPJ sample, no full national download.
RFB_SYNC=true
PYTHON_BIN=python3

# Fotos próprias da Agência Brasil, com crédito; até 60 arquivos de 1,5 MB.
NEWS_MEDIA=true
MEDIA_PATH=data/media

PORT=3001
HOST=127.0.0.1
BASE_PATH=
DATABASE_PATH=data/public-v2.sqlite
NODE_ENV=production
DEMO_MODE=false
ADMIN_ENABLED=true
# Web admin at BASE_PATH/painel, with mandatory second factor and HTTPS.
# Provision using scripts/admin-2fa.mjs before enabling.
ADMIN_WEB_ENABLED=false
# Optional one-time provisioning file outside dist, generated by the HTTP process.
# Remove after collecting the private setup file. Never publish this file.
ADMIN_2FA_SETUP_FILE=
ADMIN_PORT=3002
ADMIN_ORIGIN=http://127.0.0.1:3002
# For web access, use ADMIN_HTTPS=true and ADMIN_ORIGIN=https://your-host.
ADMIN_HTTPS=false
# Optional private spool for hosts that separate SSH and HTTP servers; outside dist.
ADMIN_BRIDGE_DIR=
REPORT_EMAIL=relatos@exemplo.invalid
AUTO_SYNC=true
PUBLIC_ORIGIN=http://127.0.0.1:3001
# Free mode requires no linked billing; paid mode requires verified Prepay, no auto-reload.
AI_ENABLED=false
AI_BILLING_MODE=free
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_PAID_TIER_CONFIRMED=false
# Cumulative test allowance, never automatically replenished; hard maximum US$4.50 in code.
# Estimate includes every Google search even when covered by the provider allowance.
AI_TOTAL_BUDGET_USD=4.5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Google Search grounding is unavailable free for new accounts (verified 2026-10-27).
AI_INTERACTIVE_ENABLED=false
# Global ceiling, including failures. 3 calls reserved for the daily catalog.
# Set BELOW the actual AI Studio project quota. No paid fallback or retries.
AI_DAILY_LIMIT=60
AI_CONNECTION_LIMIT=30
# Somente atrás do proxy HTTP do Alwaysdata (X-Real-IP substituído pela hospedagem).
TRUST_ALWAYS_DATA_PROXY=false

# Fotos próprias da Agência Brasil, com crédito; até 60 arquivos de 1,5 MB.
NEWS_MEDIA=true
MEDIA_PATH=data/media
